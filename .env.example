# Alfa COS v0.1 - Environment Variables (optional, for initial migration only)
# Copy this file to .env and fill in values locally. Never commit .env.
#
# NOTE: Alfa COS stores settings in prototype/config/config.json.
# Environment variables are only used for one-time migration on first run.

ALFA_PROVIDER=mock
ALFA_NVIDIA_API_KEY=
ALFA_MODEL=z-ai/glm-5.2
ALFA_OPENROUTER_API_KEY=
ALFA_REQUEST_TIMEOUT=30
